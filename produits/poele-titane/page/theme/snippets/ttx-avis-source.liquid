{%- comment -%}
  Mention de transparence obligatoire au-dessus de tout bloc d'avis (directive Omnibus 2019/2161).
  Paramètres : intitule, collecte.
{%- endcomment -%}
<div class="ttx-avis-source">
  <p class="ttx-avis-source__intitule">{{ intitule | escape }}</p>
  <p class="ttx-avis-source__collecte">{{ collecte }}</p>
</div>
